# Integración: te la entrega tu ejecutivo  |  Producción: https://api.virtualpos.cl
VIRTUALPOS_API_URL=
# Portal de comercio › Perfil › Configuración de cuenta › Integración (del mismo ambiente)
VIRTUALPOS_API_KEY=
VIRTUALPOS_SECRET_KEY=
# ID del plan habilitado para el POS. Créalo una vez con: java -jar target/*.jar crear-plan
VIRTUALPOS_PLAN_ID=
# POS de tu comercio, separados por coma: serial:nombre
POS_TERMINALES=N86PWF00000:Sucursal centro
# URL pública con la que Virtualpos llega a tu servidor (por ejemplo, la de ngrok)
PUBLIC_URL=http://localhost:8080
PORT=8080
