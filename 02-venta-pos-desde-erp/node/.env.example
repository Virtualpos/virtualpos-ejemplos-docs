# Integración: https://ms-payment-c2c.virtualpos-dev.com/ms-payment-c2c
# Producción:  https://ms-payment-c2c.virtualpos.cl/ms-payment-c2c
VIRTUALPOS_POS_API_URL=https://ms-payment-c2c.virtualpos-dev.com/ms-payment-c2c
# Te los entrega tu ejecutivo (no están en el portal de comercio)
VIRTUALPOS_POS_API_KEY=
VIRTUALPOS_WEBHOOK_SECRET=
# Serial del POS que cobra. En integración, el de tu POS virtual del simulador
VIRTUALPOS_POS_SERIAL=
# URL pública con la que Virtualpos llega a tu servidor (por ejemplo, la de ngrok)
PUBLIC_URL=http://localhost:3000
PORT=3000
