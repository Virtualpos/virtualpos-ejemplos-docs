{
    "name": "virtualpos/ejemplo-suscripcion-mensual",
    "description": "Ejemplo: cobrar una suscripción mensual con Pagar y suscribir de Virtualpos",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": { "Ejemplo\\": "src/" }
    },
    "scripts": {
        "start": ["Composer\\Config::disableProcessTimeout", "php -S localhost:8000 -t public"],
        "verificar": "php bin/verificar.php",
        "crear-plan": "php bin/crear-plan.php"
    }
}
